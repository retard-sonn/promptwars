# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Gemini. Leave blank for rules-only analysis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# AWS Bedrock. Uses a bearer API key or the standard AWS credential chain.
BEDROCK_API_KEY=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=us.moonshotai.kimi-k3.1
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# Threat sources. Each source is independent and optional.
GOOGLE_WEB_RISK_API_KEY=
URLHAUS_AUTH_KEY=
PHISHTANK_API_KEY=
OPENPHISH_FEED_URL=https://openphish.com/feed.txt
VIRUSTOTAL_API_KEY=
ENABLE_SHORTENER_EXPANSION=false

# Upstash rate limiting and threat-result caching.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
IP_HASH_PEPPER=replace-with-a-random-local-value
MESSAGE_HASH_PEPPER=replace-with-a-random-local-value

# Cloudflare Turnstile. Analysis skips verification when both values are blank.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Supabase. Saving and history stay hidden until public values are configured.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Error monitoring. No message content is attached to events.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Analytics. Only allow-listed event names and properties are sent.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# Playwright
PLAYWRIGHT_BASE_URL=http://localhost:3002
